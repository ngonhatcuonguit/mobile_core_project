# Uncomment this line to define a global platform for your project
# platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

platform :ios, '17.0'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
  'Debug-dev' => :debug,
  'Release-dev' => :release,
  'Profile-dev' => :release,
  'Debug-prod' => :debug,
  'Release-prod' => :release,
  'Profile-prod' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.0'
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      # Fix for Xcode 16+ strict modular header enforcement
      if ['firebase_messaging', 'firebase_crashlytics'].include?(target.name)
        config.build_settings['DEFINES_MODULE'] = 'NO'
      end
    end
  end

  # Patch firebase_messaging: replace non-modular #import <Firebase/Firebase.h>
  messaging_h = File.expand_path(
    '~/.pub-cache/hosted/pub.dev/firebase_messaging-14.9.4/ios/Classes/FLTFirebaseMessagingPlugin.h'
  )
  if File.exist?(messaging_h)
    content = File.read(messaging_h)
    if content.include?('#import <Firebase/Firebase.h>')
      File.write(messaging_h, content.gsub('#import <Firebase/Firebase.h>', '#import <FirebaseMessaging/FirebaseMessaging.h>'))
      puts '[auto-patch] Patched FLTFirebaseMessagingPlugin.h'
    end
  end

  # Patch firebase_crashlytics: replace non-modular #import <Firebase/Firebase.h>
  ['Crashlytics_Platform.h', 'ExceptionModel_Platform.h'].each do |fname|
    crashlytics_h = File.expand_path(
      "~/.pub-cache/hosted/pub.dev/firebase_crashlytics-3.5.7/ios/Classes/#{fname}"
    )
    if File.exist?(crashlytics_h)
      content = File.read(crashlytics_h)
      if content.include?('#import <Firebase/Firebase.h>')
        File.write(crashlytics_h, content.gsub('#import <Firebase/Firebase.h>', '#import <FirebaseCrashlytics/FirebaseCrashlytics.h>'))
        puts "[auto-patch] Patched #{fname}"
      end
    end
  end
end
