{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Prepare Flutter local environment",
      "type": "shell",
      "command": "${workspaceFolder}/tool/flutter_local.sh",
      "args": [
        "pub",
        "get"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
